# Copie para .env e preencha. Nunca versione o .env.
CHIRPSTACK_BASE_URL=https://chirpstack-v4-rest-api.adailsilva.com.br
CHIRPSTACK_API_TOKEN=
# openssl rand -base64 48
APP_JWT_SECRET=
APP_ADMIN_EMAIL=admin@chirpstack.local
APP_ADMIN_PASSWORD=
DB_PASSWORD=
# Chave que cifra os segredos do Google Drive no banco: openssl rand -base64 32
APP_CHAVE_CIFRAGEM=
APP_TIMEZONE=America/Fortaleza
# Opcionais (também podem ser cadastrados na tela Backup > Google Drive)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
