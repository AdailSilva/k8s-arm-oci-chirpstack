# O `COPY . .` do Dockerfile levaria tudo isto para o contexto de build.
# node_modules local (de outro SO/arquitetura) sobrescreveria o instalado pelo
# `npm ci` dentro do container, e dist/ antigo poderia mascarar um build falho.
node_modules/
dist/
.angular/
.vscode/
.idea/
*.log
kubernetes/
Dockerfile
.dockerignore
